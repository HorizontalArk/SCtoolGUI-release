<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    テスト対象のロジックはWin32やWPFに依存しないため、WPFプロジェクトを参照せず
    ソースをリンクして取り込む。これによりテストは net10.0 のまま高速に動く。
  -->
  <ItemGroup>
    <Compile Include="..\Logic\WindowMatcher.cs" Link="Source\WindowMatcher.cs" />
    <Compile Include="..\Logic\WindowItem.cs" Link="Source\WindowItem.cs" />
    <Compile Include="..\Logic\TargetInfo.cs" Link="Source\TargetInfo.cs" />
    <Compile Include="..\Logic\SettingsManager.cs" Link="Source\SettingsManager.cs" />
    <Compile Include="..\Logic\ProcessElevation.cs" Link="Source\ProcessElevation.cs" />
    <Compile Include="..\Logic\FileNameUtil.cs" Link="Source\FileNameUtil.cs" />
    <Compile Include="..\Logic\ShortcutLocationResolver.cs" Link="Source\ShortcutLocationResolver.cs" />
    <Compile Include="..\Logic\FolderRenamePlanner.cs" Link="Source\FolderRenamePlanner.cs" />
    <Compile Include="..\Logic\PreviewOrientationLogic.cs" Link="Source\PreviewOrientationLogic.cs" />
    <Compile Include="..\Logic\IconIcoWriter.cs" Link="Source\IconIcoWriter.cs" />
    <Compile Include="..\Logic\ShortcutIconUpdater.cs" Link="Source\ShortcutIconUpdater.cs" />
    <Compile Include="..\Logic\FileBaseNameResolver.cs" Link="Source\FileBaseNameResolver.cs" />
    <Compile Include="..\Logic\CaptureFileName.cs" Link="Source\CaptureFileName.cs" />
    <Compile Include="..\Logic\LogFormatter.cs" Link="Source\LogFormatter.cs" />
    <Compile Include="..\Logic\CopyTargetResolver.cs" Link="Source\CopyTargetResolver.cs" />
    <Compile Include="..\Logic\DeveloperModeGate.cs" Link="Source\DeveloperModeGate.cs" />
    <Compile Include="..\Logic\WindowPlacementLogic.cs" Link="Source\WindowPlacementLogic.cs" />
    <Compile Include="..\Logic\FocusRestoreLogic.cs" Link="Source\FocusRestoreLogic.cs" />
    <Compile Include="..\Logic\UpdateFlow.cs" Link="Source\UpdateFlow.cs" />
    <Compile Include="..\Logic\CopyButtonState.cs" Link="Source\CopyButtonState.cs" />
    <Compile Include="..\Logic\CaptureCropCalculator.cs" Link="Source\CaptureCropCalculator.cs" />
    <Compile Include="..\Logic\HotKeyDisplay.cs" Link="Source\HotKeyDisplay.cs" />
  </ItemGroup>

</Project>