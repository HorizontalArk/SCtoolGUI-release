<Window x:Class="SCtoolGui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="詳細設定" Width="420" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="保存先フォルダ:" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtSaveDir" VerticalContentAlignment="Center" Padding="5"/>
                <Button Content="参照..." Grid.Column="1" Margin="5,0,0,0" Padding="10,0" Click="BtnBrowse_Click"/>
            </Grid>

            <TextBlock Text="ホットキー設定 (デフォルト: Ctrl+Shift+S):" Margin="0,0,0,5"/>
            <!-- Fluentテーマの CheckBox は MinWidth が大きく、Ctrl/Shift/Alt とキー選択を
                 横一列に並べると固定幅420pxの窓からはみ出してキー選択が見切れる。
                 そのためキー選択は次の行に分ける。 -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <CheckBox x:Name="ChkCtrl" Content="Ctrl" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ChkShift" Content="Shift" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <CheckBox x:Name="ChkAlt" Content="Alt" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="キー:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox x:Name="CmbKey" Width="80" MinHeight="28" VerticalContentAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="ChkAppTopmost" Content="SCtool本体を常に最前面に表示する" Margin="0,0,0,10"/>
            
            <CheckBox x:Name="ChkSaveInWindowFolder" Content="ウィンドウ名のフォルダに分類して保存する" Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkResetSettingsOnWindowChange" Content="ウィンドウ切り替え時に上部カットを外す" Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkAutoCopyClipboard" Content="キャプチャ時に画像をクリップボードに自動コピーする" Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkAlwaysRunAsAdmin" Content="常に管理者として起動する（管理者権限のアプリを常用する場合）" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                <TextBlock Text="テーマ:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbTheme" Width="190">
                    <ComboBoxItem Content="システム（OSに追従）"/>
                    <ComboBoxItem Content="ライト"/>
                    <ComboBoxItem Content="ダーク"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                <TextBlock Text="縦モード時のプレビュー位置:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbVerticalSide" Width="120">
                    <ComboBoxItem Content="右"/>
                    <ComboBoxItem Content="左"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                <TextBlock Text="縦横の自動切替:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbAutoSwitch" Width="200">
                    <ComboBoxItem Content="切り替えない"/>
                    <ComboBoxItem Content="確認して切り替え"/>
                    <ComboBoxItem Content="自動で切り替え"/>
                </ComboBox>
            </StackPanel>

            <TextBlock Text="アイコン（空欄で既定）:" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtIconPath" Grid.Column="0" VerticalContentAlignment="Center" Padding="5" IsReadOnly="True"/>
                <Button Grid.Column="1" Content="参照..." Margin="5,0,0,0" Padding="10,0" Click="BtnBrowseIcon_Click"/>
                <Button Grid.Column="2" Content="クリア" Margin="5,0,0,0" Padding="10,0" Click="BtnClearIcon_Click"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                <CheckBox x:Name="ChkPlayShutterSound" Content="シャッター音を鳴らす" VerticalAlignment="Center" Margin="0,0,15,0"/>
                <TextBlock Text="音量:" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="Gray"/>
                <Slider x:Name="SldVolume" Width="100" Minimum="0" Maximum="100" Value="100" TickFrequency="10" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ElementName=SldVolume, Path=Value}" VerticalAlignment="Center" Margin="5,0,0,0" Width="25" TextAlignment="Right"/>
                <TextBlock Text="%" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="保存" Width="80" Margin="0,0,10,0" Click="BtnSave_Click"/>
                <Button Content="キャンセル" Width="80" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>