<Window x:Class="SCtoolGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SCtool" Height="660" Width="820" MinWidth="700" MinHeight="470"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- 角丸カード（テーマ連動の面と枠） -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- カード見出し -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,8"/>
        </Style>

        <!-- Fluent アイコン（Segoe グリフ） -->
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Win11 風トグルスイッチ（CheckBox を再テンプレート。クリック挙動はそのまま） -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="40" Height="20" CornerRadius="10" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource TextFillColorTertiaryBrush}" BorderThickness="1">
                                <Ellipse x:Name="thumb" Width="12" Height="12" HorizontalAlignment="Left" Margin="4,0,0,0"
                                         Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="thumb" Property="Fill" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 更新バナー -->
        <Border x:Name="UpdateBanner" Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,12" Padding="12,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource Icon}" Text="&#xE946;" Margin="0,0,10,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="新しいアップデートがあります。" VerticalAlignment="Center"/>
                <Button x:Name="BtnUpdate" Grid.Column="2" Content="更新して再起動" Padding="14,6" FontWeight="SemiBold"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        Click="BtnUpdate_Click"/>
            </Grid>
        </Border>

        <!-- ウィンドウ指定 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="ウィンドウ指定"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbWindows" Grid.Column="0" DropDownOpened="CmbWindows_DropDownOpened"
                              VerticalContentAlignment="Center" MinHeight="32"
                              ToolTip="キャプチャ対象のウィンドウを選択します">
                        <!-- 各行をアイテム幅いっぱいに広げ、余白部分もクリック判定に含める -->
                        <ComboBox.ItemContainerStyle>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ComboBox.ItemContainerStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Background="Transparent" で文字の無い余白もヒットテスト対象にする -->
                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                    <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"
                                           Stretch="Uniform" VerticalAlignment="Center" SnapsToDevicePixels="True"/>
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="BtnRenameTarget" Grid.Column="1" Margin="8,0,0,0" Padding="10,4" Click="BtnRenameTarget_Click"
                            ToolTip="このアプリの呼び名を変更します&#x0a;保存フォルダ名にも使われます">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Margin="0,0,6,0"/>
                            <TextBlock Text="名前変更" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="ChkAlwaysOnTop" Style="{StaticResource ToggleSwitch}" Content="最前面固定" VerticalAlignment="Center" Margin="0,0,24,0" Click="ChkAlwaysOnTop_Click"
                              ToolTip="選択したウィンドウを常に他の画面より手前に表示します"/>
                    <CheckBox x:Name="ChkCutTab" Style="{StaticResource ToggleSwitch}" Content="上部カット" VerticalAlignment="Center" Margin="0,0,10,0" IsChecked="False" Click="ChkCutTab_Click"
                              ToolTip="キャプチャ時に画像の上部を指定ピクセル分カットして保存します"/>
                    <TextBox x:Name="TxtTopCut" Text="35" Width="44" MinHeight="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"
                             PreviewMouseWheel="TxtTopCut_PreviewMouseWheel" TextChanged="TxtTopCut_TextChanged" MouseDoubleClick="TxtTopCut_MouseDoubleClick"
                             ToolTip="カットするピクセル数&#x0a;・ホイール回転で増減&#x0a;・ダブルクリックで 0 にリセット"/>
                    <TextBlock Text="px" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>

                <TextBlock x:Name="TxtWindowStatus" Margin="0,12,0,0" FontWeight="SemiBold" Foreground="Gray" Text="ウィンドウ状態: 取得中..."/>
                <TextBlock x:Name="TxtCurrentSavePath" Margin="0,6,0,0" TextWrapping="Wrap" Text="現在の保存先: "
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <!-- 操作: 詳細設定 / フォルダ / キャプチャ（同じ行で、キャプチャが右方向いっぱいに伸びる） -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnSettings" Grid.Column="0" Height="44" Padding="14,0" Margin="0,0,10,0" Click="BtnSettings_Click"
                    ToolTip="ホットキーや保存先などの詳細設定を開きます">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" Margin="0,0,8,0"/>
                    <TextBlock Text="詳細設定" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnOpenFolder" Grid.Column="1" Height="44" Padding="14,0" Margin="0,0,10,0" Click="BtnOpenFolder_Click"
                    ToolTip="画像の保存先フォルダをエクスプローラーで開きます">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,8,0"/>
                    <TextBlock Text="フォルダ" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnCapture" Grid.Column="2" Height="44" FontWeight="SemiBold" Click="BtnCapture_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                    ToolTip="選択中のウィンドウのスクリーンショットを撮影・保存します">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE722;" FontSize="17" Margin="0,0,10,0"/>
                    <TextBlock Text="スクリーンショットを撮る" FontSize="15" VerticalAlignment="Center"/>
                    <Border Margin="12,0,0,0" Padding="7,2" CornerRadius="4" Background="#33FFFFFF">
                        <TextBlock x:Name="TxtCaptureHotkey" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Button>
        </Grid>

        <!-- プレビュー（主役・全幅） -->
        <Border Grid.Row="3" Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource CardTitle}" Text="プレビュー"/>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Viewbox Stretch="Uniform">
                        <Grid x:Name="PreviewContentGrid" Background="Transparent"
                              MouseWheel="PreviewContentGrid_MouseWheel"
                              MouseLeftButtonDown="PreviewContentGrid_MouseLeftButtonDown"
                              MouseLeftButtonUp="PreviewContentGrid_MouseLeftButtonUp"
                              MouseMove="PreviewContentGrid_MouseMove">

                            <Image x:Name="ImgPreview" Stretch="None" SizeChanged="ImgPreview_SizeChanged"/>

                            <Rectangle x:Name="CutOverlayRect" Fill="#80FF0000" VerticalAlignment="Top" HorizontalAlignment="Stretch" Visibility="Collapsed" IsHitTestVisible="False"/>

                            <Canvas IsHitTestVisible="False">
                                <Line x:Name="CutBoundaryLine" StrokeThickness="1" SnapsToDevicePixels="True" Y1="0" Y2="0" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Line.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="Transparent" Offset="0.0"/>
                                            <GradientStop Color="#333333" Offset="0.1"/>
                                            <GradientStop Color="#333333" Offset="0.9"/>
                                            <GradientStop Color="Transparent" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Line.Stroke>
                                </Line>
                            </Canvas>
                        </Grid>
                    </Viewbox>

                    <Border x:Name="PreviewWatermarkBorder"
                            VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10"
                            Background="#80000000" CornerRadius="12" Padding="12,5"
                            IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock Text="一時プレビュー (未保存)" FontSize="12" FontWeight="Normal" Foreground="#F0F0F0"/>
                    </Border>

                    <TextBlock x:Name="TxtDeleteMessage" Text="画像を削除しました" VerticalAlignment="Center" HorizontalAlignment="Center"
                               FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="Collapsed"/>
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnRefreshPreview" Padding="12,6" Margin="0,0,16,0" Click="BtnRefreshPreview_Click"
                            ToolTip="現在のウィンドウの最新状態を一時プレビューとして再取得します">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Margin="0,0,6,0"/>
                            <TextBlock Text="更新" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnOpenFile" Padding="10,6" Margin="0,0,6,0" IsEnabled="False" Click="BtnOpenFile_Click"
                            ToolTip="最後に保存した画像を既定のアプリで開きます" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8E5;" Margin="0,0,6,0"/>
                            <TextBlock Text="開く" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCopyClipboard" Padding="10,6" Margin="0,0,6,0" IsEnabled="False" Click="BtnCopyClipboard_Click"
                            ToolTip="最後に保存した画像をクリップボードにコピーします" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,6,0"/>
                            <TextBlock Text="コピー" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnDeleteFile" Padding="10,6" IsEnabled="False" Click="BtnDeleteFile_Click"
                            ToolTip="最後に保存した画像をPCから完全に削除します" ToolTipService.ShowOnDisabled="True">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <TextBlock Text="削除" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ログ（下部・全幅のコンパクトなストリップ。最新行が常に見える／右のボタンで展開） -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtLog" Grid.Column="0" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" Padding="0"
                         VerticalAlignment="Top" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Height" Value="42"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=BtnLogExpand}" Value="True">
                                    <Setter Property="Height" Value="180"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>

                <ToggleButton x:Name="BtnLogExpand" Grid.Column="1" VerticalAlignment="Top" Margin="8,0,0,0" Padding="6,4"
                              Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="ログを展開／折りたたむ">
                    <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" Text="&#xE70D;" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=BtnLogExpand}" Value="True">
                                        <Setter Property="RenderTransform">
                                            <Setter.Value><RotateTransform Angle="180"/></Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </ToggleButton>
            </Grid>
        </Border>
    </Grid>
</Window>
